{
  "name": "api",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "migrate:down": "tsx --env-file-if-exists=../../.env src/migrate.ts down",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "gen:openapi": "tsx src/scripts/gen-openapi.ts",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/db/types.ts --exclude-pattern kysely_*"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
