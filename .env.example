# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Для локальной разработки значения по умолчанию подставляются в compose.yml и apps/api/src/config.ts.

# --- API ---
NODE_ENV=
PORT=
LOG_LEVEL=
DATABASE_URL=
SESSION_SECRET=
COOKIE_SECURE=
SESSION_TTL_HOURS=

# --- Postgres (используется контейнером db) ---
POSTGRES_DB=
POSTGRES_USER=
DB_PASSWORD=

# --- Прод (compose.prod.yml) ---
DOMAIN=
IMAGE_REGISTRY=
IMAGE_TAG=
